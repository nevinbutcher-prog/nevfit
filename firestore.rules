rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/programs/{programId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/completedWorkouts/{workoutId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/appState/{docId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Staging copies only. Future CRUD needs a separate reviewed rules change.
    match /users/{userId}/workouts/{workoutId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.id == workoutId
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.archived is bool
        && (request.resource.data.programId == null || request.resource.data.programId is string)
        && request.resource.data.exercises is list;
      allow update, delete: if false;
    }

    match /users/{userId}/programsV2/{programId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.id == programId
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.archived is bool
        && request.resource.data.workoutIds is list
        && !request.resource.data.keys().hasAny(['days', 'routines']);
      allow update, delete: if false;
    }
  }
}
